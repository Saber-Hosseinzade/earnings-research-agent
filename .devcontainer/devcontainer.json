{
  "name": "earnings-research-agent",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/aws-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },

  // SSO config and the login token cache live on the host, so `aws sso login`
  // on the host also logs the container in. Read-write: the CLI refreshes tokens.
  "mounts": [
    "source=${localEnv:HOME}/.aws,target=/home/vscode/.aws,type=bind"
  ],

  // The default profile inside this container.
  "containerEnv": {
    "AWS_PROFILE": "sandbox",
    "AWS_REGION": "eu-central-1",
    "AWS_DEFAULT_REGION": "eu-central-1"
  },

  // Virtualenv outside the bind-mounted workspace, so a host .venv can't collide with it.
  "postCreateCommand": "python -m venv /home/vscode/.venv && /home/vscode/.venv/bin/pip install -q --upgrade pip && /home/vscode/.venv/bin/pip install -q -r requirements-dev.txt",
  "remoteEnv": {
    "PATH": "/home/vscode/.venv/bin:${containerEnv:PATH}",
    "VIRTUAL_ENV": "/home/vscode/.venv"
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"],
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"]
      }
    }
  },

  "remoteUser": "vscode"
}
