{
  "name": "earnings-research-agent",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/aws-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    // Claude Code CLI + the VS Code extension (the feature adds both)
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },

  "mounts": [
    // A dedicated AWS config folder on the host, not ~/.aws.
    // Only these credentials are visible inside the container.
    "source=${localEnv:HOME}/.aws-sandbox,target=/home/vscode/.aws,type=bind",
    // Claude Code login, settings and history survive container rebuilds
    "source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume"
  ],

  "containerEnv": {
    "AWS_PROFILE": "sandbox",
    "AWS_REGION": "eu-central-1",
    "AWS_DEFAULT_REGION": "eu-central-1",
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },

  // Virtualenv outside the bind-mounted workspace, so a host .venv can't collide with it.
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteEnv": {
    "PATH": "/home/vscode/.venv/bin:${containerEnv:PATH}",
    "VIRTUAL_ENV": "/home/vscode/.venv"
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "anthropic.claude-code"],
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"]
      }
    }
  },

  "remoteUser": "vscode"
}
