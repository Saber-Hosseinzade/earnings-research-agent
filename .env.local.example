# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# Read by scripts/pull_corpus.py and scripts/pull_corpus_v2.py; variables already set in the shell win.

# Alpha Vantage keys, comma-separated, used in order (rotated on the daily cap).
ALPHAVANTAGE_API_KEYS=

# Your own key for the v2 transcript API (see the README, "Evaluation corpus").
TRANSCRIPT_API_KEY=
TRANSCRIPT_API_BASE=
